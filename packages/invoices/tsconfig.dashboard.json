{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/gql": ["./src/gql/graphql.ts"],
      "@/vdb/*": ["./node_modules/@vendure/dashboard/src/lib/*"]
    }
  },
  "include": ["src/dashboard/**/*.ts", "src/dashboard/**/*.tsx", "src/gql/**/*.ts", "vite.*.*ts"]
}
