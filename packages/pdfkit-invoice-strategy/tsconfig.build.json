{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    // The dev config maps the sibling plugin to its *sources*, which is handy while editing
    // but pulls files outside rootDir into the emit. Consumers resolve the built types
    // through node_modules, so the build does the same.
    "paths": {}
  },
  "files": ["./src/index.ts"]
}
