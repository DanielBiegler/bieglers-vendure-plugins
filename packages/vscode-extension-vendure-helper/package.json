{
  "name": "bieglers-vendure-helper-vscode-extension",
  "displayName": "Bieglers Vendure Helper",
  "description": "%description%",
  "license": "MIT",
  "version": "1.2.0",
  "scripts": {
    "check-types": "tsc --noEmit -p .",
    "compile": "npm run check-types && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "test": "vscode-test",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch-tests": "tsc -p . -w --outDir out",
    "package": "npm run check-types && node esbuild.js --production && vsce package --no-dependencies --baseImagesUrl 'https://raw.githubusercontent.com/DanielBiegler/bieglers-vendure-plugins/master/packages/vscode-extension-vendure-helper/' --baseContentUrl 'https://github.com/DanielBiegler/bieglers-vendure-plugins/tree/master/packages/vscode-extension-vendure-helper'"
  },
  "devDependencies": {
    "@types/vscode": "1.104.0",
    "@types/mocha": "10.0.10",
    "@types/node": "22.x",
    "@vscode/test-cli": "0.0.11",
    "@vscode/test-electron": "2.5.2"
  },
  "files": [
    "package.json",
    "package.nls*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.txt",
    "dist/**",
    "l10n/**"
  ],
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Education"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "bieglers-vendure-helper.docSearch",
        "title": "%docSearch.title%",
        "category": "Bieglers Vendure Helper"
      },
      {
        "command": "bieglers-vendure-helper.copyDocUri",
        "title": "%copyUri.title%",
        "category": "Bieglers Vendure Helper",
        "enablement": "inQuickOpen"
      }
    ],
    "keybindings": [
      {
        "command": "bieglers-vendure-helper.docSearch",
        "key": "ctrl+k v",
        "mac": "cmd+k v"
      },
      {
        "command": "bieglers-vendure-helper.copyDocUri",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "inQuickOpen"
      }
    ],
    "configuration": {
      "properties": {
        "bieglers-vendure-helper-vscode-extension.openInternally": {
          "type": "boolean",
          "default": true,
          "title": "%config.openInternally.title%",
          "description": "%config.openInternally.description%"
        }
      }
    }
  },
  "author": {
    "name": "Daniel Biegler",
    "url": "https://www.danielbiegler.de"
  },
  "bugs": {
    "url": "https://github.com/DanielBiegler/bieglers-vendure-plugins/issues"
  },
  "homepage": "https://github.com/DanielBiegler/bieglers-vendure-plugins/packages/vscode-extension-vendure-helper",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielBiegler/bieglers-vendure-plugins"
  }
}
